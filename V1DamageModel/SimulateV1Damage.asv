%     
%     trialDecisionsDamaged(trialIDx) = decision;
%     trialConfsDamaged(trialIDx)     = conf;
%     trialPDFsDamaged{trialIDx}      = pdf;
% 
%     % Bin and then save spikes, Sum within each 10-ms bin
%     binSize = 10; 
%     nBins = floor(size(spikes, 2)/binSize);
